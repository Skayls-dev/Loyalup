{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:widget": "vite build --config vite.widget.config.ts",
    "build:sdk": "npm --prefix packages/loyalup-sdk run build",
    "smoke:week9": "node scripts/week9-smoke.mjs",
    "seed:coalition": "node scripts/seed-coalition-test-data.mjs",
    "smoke:week9:serve": "supabase functions serve --env-file .env.functions.local",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest --run",
    "predeploy": "bash scripts/pre-deploy-check.sh",
    "predeploy:win": "powershell -ExecutionPolicy Bypass -File scripts/pre-deploy-check.ps1",
    "predeploy:local": "npm run predeploy:win",
    "smoke:runtime:win": "powershell -ExecutionPolicy Bypass -File scripts/runtime-smoke-check.ps1",
    "smoke:runtime:win:no-server": "powershell -ExecutionPolicy Bypass -File scripts/runtime-smoke-check.ps1 -NoServer",
    "db:push:prod:win:dry-run": "powershell -ExecutionPolicy Bypass -File scripts/push-prod-migrations.ps1 -DbPassword \"%SUPABASE_DB_PASSWORD%\" -DryRun",
    "db:push:prod:win:apply": "powershell -ExecutionPolicy Bypass -File scripts/push-prod-migrations.ps1 -DbPassword \"%SUPABASE_DB_PASSWORD%\" -Apply",
    "functions:deploy:prod:safe": "npx supabase functions deploy --project-ref yyftqivizzgvveeczbpv",
    "functions:deploy:prod": "npx supabase functions deploy --project-ref yyftqivizzgvveeczbpv --prune",
    "deploy:staging": "vercel",
    "deploy:prod": "vercel --prod",
    "supabase:mode:local": "node scripts/supabase-config-mode.mjs local",
    "supabase:mode:prod": "node scripts/supabase-config-mode.mjs prod",
    "supabase:mode:check": "node scripts/supabase-config-mode.mjs check-prod"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.511.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@supabase/supabase-js": "^2.97.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0-beta.13",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  }
}
